{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storied",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": false },
  "routes": [{ "pattern": "storied.alecakin.com", "custom_domain": true }],
}

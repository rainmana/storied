{"schemaVersion":3,"studio":{"samples":[],"profiles":[],"runs":[{"id":"165c2d98-05fd-475a-9926-0b869f40141e","kind":"draft","sceneId":"4cad36cc-79c0-46d5-86ce-daa20f759bb5","createdAt":"2026-09-06T07:23:06.768Z","worldRevision":4,"mode":"opening","direction":"Write one short paragraph: Mara waits for a ferry. Under 40 words. Keep all events ordinary.","sceneText":"","start":0,"end":0,"candidate":"Under the quiet tide, Mara waited for a ferry. Ivo Senn, the last keeper of the Ninth Lantern, was passing by, his eyes fixed on the horizon, and Nera Moss, who had been known since childhood, leaned forward to hear her grandfather's words about navigation.","context":"{\"world\":\"The Quiet Tide\",\"scene\":\"What the water remembers\",\"purpose\":\"\",\"perspective\":\"third\",\"viewpoint\":\"\",\"participants\":[\"0bec5c2d-952b-4355-9211-7403f3f77e5a\",\"6e094709-1e78-435b-8fbe-89b742cc1341\"],\"location\":\"\",\"time\":\"\",\"branch\":\"\",\"branchHead\":\"\",\"authorInstructions\":\"Write with specificity and restraint. Leave room for the player to choose. Never decide the player character’s actions or speech.\",\"sceneNotes\":\"Open with a discrepancy small enough to dismiss, and specific enough to remember.\",\"recentBranch\":[],\"before\":\"\",\"after\":\"\"}","sources":[{"id":"0bec5c2d-952b-4355-9211-7403f3f77e5a","kind":"entity","title":"Mara Vale","text":"{\"type\":\"Character\",\"summary\":\"Mara keeps a spare notebook in her coat and writes down the names of passing ships.\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"ec9866af-c1c2-4ff1-a1bb-50b55149a04e","kind":"entity","title":"Ivo Senn","text":"{\"type\":\"Character\",\"summary\":\"The last keeper of the Ninth Lantern. A patient man with salt-white hair, ink-stained fingers, and a habit of answering questions with questions.\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"80815310-4a9a-46b6-9ac6-b75562048a33","kind":"entity","title":"Nera Moss","text":"{\"type\":\"Character\",\"summary\":\"A ferryperson who knows every channel through the tidal flats. She remembers the names of everyone who has crossed with her.\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"3330cf2c-d8b4-468a-97a8-1cb886095ecc","kind":"entity","title":"Bellwether","text":"{\"type\":\"Location\",\"summary\":\"A small town arranged around a horseshoe harbor. At low tide, an old road emerges from the water and leads toward a place absent from every map.\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"6e094709-1e78-435b-8fbe-89b742cc1341","kind":"entity","title":"The Ninth Lantern","text":"{\"type\":\"Location\",\"summary\":\"A decommissioned lighthouse on the headland. Its nine windows look toward nine different stretches of sea. Only eight can be seen from outside.\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"1902e26b-2160-4520-95e0-40a3f8d94763","kind":"entity","title":"The Tidekeepers","text":"{\"type\":\"Faction\",\"summary\":\"A loose association of navigators, fishers, and keepers. They maintain the channel markers and an archive of everything the sea has returned.\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"43fd20b6-2933-42d2-8f11-de68ce80d535","kind":"fact","title":"The Ninth Lantern: last lit","text":"{\"subjectId\":\"6e094709-1e78-435b-8fbe-89b742cc1341\",\"predicate\":\"last lit\",\"value\":\"Seven years ago, on the night Mara left town.\",\"visibility\":\"public\",\"knownTo\":[]}","writerAllowed":true},{"id":"f5cd20af-f5f1-4484-bfdb-7834c2ecf828","kind":"relationship","title":"born in","text":"{\"from\":\"0bec5c2d-952b-4355-9211-7403f3f77e5a\",\"to\":\"3330cf2c-d8b4-468a-97a8-1cb886095ecc\",\"description\":\"\",\"visibility\":\"public\"}","writerAllowed":true},{"id":"a6491dae-dc2e-45fd-abb8-52832e3dcb8c","kind":"relationship","title":"cares for","text":"{\"from\":\"ec9866af-c1c2-4ff1-a1bb-50b55149a04e\",\"to\":\"6e094709-1e78-435b-8fbe-89b742cc1341\",\"description\":\"\",\"visibility\":\"public\"}","writerAllowed":tru
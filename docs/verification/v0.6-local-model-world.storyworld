de-462e3d293adf"],"error":"","trace":[{"node":"captureBoundary","authority":"read","outcome":"Completed","createdAt":"2026-09-06T07:22:15.116Z","worldRevision":0,"coordinationVersion":0},{"node":"interpretIntent","authority":"interpret","outcome":"Completed","createdAt":"2026-09-06T07:22:15.364Z","worldRevision":0,"coordinationVersion":0},{"node":"synchronizeCoordinationState","authority":"repair","outcome":"Completed","createdAt":"2026-09-06T07:22:15.589Z","worldRevision":0,"coordinationVersion":0},{"node":"graphRetrieve","authority":"read","outcome":"Completed","createdAt":"2026-09-06T07:22:15.817Z","worldRevision":0,"coordinationVersion":0},{"node":"semanticRetrieve","authority":"read","outcome":"Retrieved semantic candidates; no truth or visibility granted","createdAt":"2026-09-06T07:22:16.141Z","worldRevision":0,"coordinationVersion":0},{"node":"epistemicFilter","authority":"read","outcome":"Completed","createdAt":"2026-09-06T07:22:16.369Z","worldRevision":0,"coordinationVersion":0},{"node":"temporalFilter","authority":"read","outcome":"Explicit event order and discovery gates are enforced again during context compilation","createdAt":"2026-09-06T07:22:16.589Z","worldRevision":0,"coordinationVersion":0},{"node":"coordinationCheck","authority":"read","outcome":"Completed","createdAt":"2026-09-06T07:22:16.809Z","worldRevision":0,"coordinationVersion":0},{"node":"compileContext","authority":"read","outcome":"Completed","createdAt":"2026-09-06T07:22:17.024Z","worldRevision":0,"coordinationVersion":0},{"node":"storyteller","authority":"generate","outcome":"Completed","createdAt":"2026-09-06T07:22:34.904Z","worldRevision":0,"coordinationVersion":0},{"node":"synchronizeCoordinationState","authority":"repair","outcome":"Completed","createdAt":"2026-09-06T07:22:35.455Z","worldRevision":0,"coordinationVersion":0},{"node":"graphRetrieve","authority":"read","outcome":"Completed","createdAt":"2026-09-06T07:22:35.706Z","worldRevision":0,"coordinationVersion":0},{"node":"sema
reatedAt":"2026-09-06T03:21:33.228Z"},{"id":"79dfd645-3dca-48d5-9222-b5113a26d50f","title":"The feeling of this world","text":"Salt on a windowsill. Letters kept in a biscuit tin. The way a familiar place becomes strange when you come back to it.","kind":"note","createdAt":"2026-09-06T03:21:33.228Z"}],"assets":[],"templates":[],"settings":{"authorInstructions":"Write with specificity and restraint. Leave room for the player to choose. Never decide the player character’s actions or speech.","wordGoal":1000}}